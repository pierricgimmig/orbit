"""Locates the Debug Interface Access SDK that ships with Visual Studio.

The DIA SDK is not redistributable and is not vendored here -- only its licence
is, under third_party/DIA SDK. It arrives with Visual Studio, so this rule finds
it the same way cmake/FindDiaSdk.cmake does: through VSINSTALLDIR.

On anything other than Windows the repository is still created, but empty, so
that a Linux build can load the BUILD files that reference it. The targets that
actually need it are constrained to Windows and never get analysed there.
"""

_BUILD_HEADER = """# Generated by //bazel/deps:dia_sdk.bzl -- do not edit.

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])
"""

_BUILD_FOUND = """
cc_library(
    name = "dia_sdk",
    srcs = ["lib/{arch}/diaguids.lib"],
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    data = ["bin/{arch}/msdia140.dll"],
    target_compatible_with = ["@platforms//os:windows"],
)
"""

_BUILD_MISSING = """
# The DIA SDK was not found. Anything that depends on this fails to build with
# the message below rather than with a confusing missing-header error.
cc_library(
    name = "dia_sdk",
    target_compatible_with = ["@platforms//os:windows"],
    tags = ["manual"],
    deps = [":dia_sdk_not_found"],
)

cc_library(
    name = "dia_sdk_not_found",
    srcs = ["missing.cc"],
    target_compatible_with = ["@platforms//os:windows"],
)
"""

_MISSING_SOURCE = """#error \\
    "The DIA SDK was not found. It ships with Visual Studio; set VSINSTALLDIR \\
     to the installation directory, or DIA_SDK_DIR to the SDK itself."
"""

def _dia_sdk_impl(ctx):
    ctx.file("WORKSPACE", "workspace(name = \"%s\")\n" % ctx.name)

    if ctx.os.name.lower().find("windows") == -1:
        # Not Windows: an empty stub is enough to keep loading working.
        ctx.file("BUILD.bazel", _BUILD_HEADER + _BUILD_MISSING)
        ctx.file("missing.cc", _MISSING_SOURCE)
        return

    explicit = ctx.os.environ.get("DIA_SDK_DIR", "")
    vs_install = ctx.os.environ.get("VSINSTALLDIR", "")
    candidates = [p for p in [explicit, vs_install + "/DIA SDK"] if p]

    for candidate in candidates:
        header = ctx.path(candidate + "/include/dia2.h")
        if header.exists:
            ctx.symlink(ctx.path(candidate + "/include"), "include")
            ctx.symlink(ctx.path(candidate + "/lib"), "lib")
            ctx.symlink(ctx.path(candidate + "/bin"), "bin")
            ctx.file(
                "BUILD.bazel",
                _BUILD_HEADER + _BUILD_FOUND.format(arch = "amd64"),
            )
            return

    ctx.file("BUILD.bazel", _BUILD_HEADER + _BUILD_MISSING)
    ctx.file("missing.cc", _MISSING_SOURCE)

dia_sdk = repository_rule(
    implementation = _dia_sdk_impl,
    doc = "Finds the DIA SDK from a Visual Studio installation.",
    environ = ["VSINSTALLDIR", "DIA_SDK_DIR"],
    local = True,
)
