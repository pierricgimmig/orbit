# Service-side Rust for Orbit. See docs/rust-port-plan.html.
#
# External crates resolve through @orbit_crates, declared in MODULE.bazel from
# rust/Cargo.lock. orbit-maps still has no dependencies at all; orbit-object
# pulls `object`, whose entire transitive tree is one crate (memchr).

load("@orbit_crates//:defs.bzl", "all_crate_deps")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_static_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.lock",
    "Cargo.toml",
])

ORBIT_RUST_EDITION = "2021"

# ------------------------------------------------------------- orbit-maps

rust_library(
    name = "orbit_maps",
    srcs = glob(["crates/orbit-maps/src/**/*.rs"]),
    crate_root = "crates/orbit-maps/src/lib.rs",
    edition = ORBIT_RUST_EDITION,
)

rust_test(
    name = "orbit_maps_test",
    size = "small",
    crate = ":orbit_maps",
    edition = ORBIT_RUST_EDITION,
)

# ------------------------------------------------------------ orbit-object

rust_library(
    name = "orbit_object",
    srcs = glob(["crates/orbit-object/src/**/*.rs"]),
    crate_root = "crates/orbit-object/src/lib.rs",
    edition = ORBIT_RUST_EDITION,
    deps = all_crate_deps(package_name = "rust/crates/orbit-object"),
)

# Shares testdata with the C++ suite rather than duplicating it, so both
# implementations are judged against the same bytes.
rust_test(
    name = "orbit_object_test",
    size = "small",
    crate = ":orbit_object",
    data = ["//src/ObjectUtils:testdata"],
    edition = ORBIT_RUST_EDITION,
    env = {"ORBIT_TESTDATA": "src/ObjectUtils/testdata"},
)

# --------------------------------------------------------- orbit-maps-ffi

rust_static_library(
    name = "orbit_maps_ffi_rust",
    srcs = glob(["ffi/orbit-maps-ffi/src/**/*.rs"]),
    crate_root = "ffi/orbit-maps-ffi/src/lib.rs",
    edition = ORBIT_RUST_EDITION,
    deps = [":orbit_maps"],
)

# The same sources as a rust_library, so the crate's own #[test]s can run.
# rust_static_library produces no test-runnable target on its own.
rust_library(
    name = "orbit_maps_ffi_lib",
    srcs = glob(["ffi/orbit-maps-ffi/src/**/*.rs"]),
    crate_name = "orbit_maps_ffi",
    crate_root = "ffi/orbit-maps-ffi/src/lib.rs",
    edition = ORBIT_RUST_EDITION,
    deps = [":orbit_maps"],
)

rust_test(
    name = "orbit_maps_ffi_test",
    size = "small",
    crate = ":orbit_maps_ffi_lib",
    edition = ORBIT_RUST_EDITION,
)

