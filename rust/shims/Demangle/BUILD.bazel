# Orbit's replacement for llvm::demangle: libstdc++'s abi::__cxa_demangle for
# Itanium names, //rust:orbit_object's msvc-demangler for MSVC ones, and the
# input unchanged when neither applies.
#
# Its own target because both ObjectUtilsRust and CaptureClient need it, and
# neither should depend on the other.

load("//bazel:copts.bzl", "ORBIT_COPTS")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "Demangle",
    srcs = ["Demangle.cpp"],
    hdrs = ["Demangle.h"],
    copts = ORBIT_COPTS,
    includes = ["."],
    deps = ["//rust:orbit_object_ffi"],
)
