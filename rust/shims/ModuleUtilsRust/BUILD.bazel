# The C++ half of the Rust ParseMaps: implements Orbit's existing signature
# over the C ABI in //rust:orbit_maps_ffi. It depends on ModuleUtilsHeaders
# rather than ModuleUtils, so that ModuleUtils can depend on it without a
# cycle.

load("//bazel:copts.bzl", "ORBIT_COPTS")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "ModuleUtilsRust",
    srcs = ["ParseMapsRust.cpp"],
    hdrs = ["ParseMapsRust.h"],
    copts = ORBIT_COPTS,
    includes = ["."],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//rust:orbit_maps_ffi",
        "//src/ModuleUtils:ModuleUtilsHeaders",
        "//src/OrbitBase",
    ],
)
