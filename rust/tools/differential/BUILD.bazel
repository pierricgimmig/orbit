load("//bazel:copts.bzl", "ORBIT_COPTS")
load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "elf_corpus",
    srcs = ["elf_corpus.cpp"],
    copts = ORBIT_COPTS,
    deps = [
        "//rust/shims/ObjectUtilsRust",
        "//src/ObjectUtils",
        "//src/OrbitBase",
    ],
)

cc_binary(
    name = "perf_reader_differential",
    srcs = ["perf_reader_differential.cpp"],
    copts = ORBIT_COPTS + [
        "-Isrc/LinuxTracing",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//rust:orbit_perf_records_ffi",
        "//src/LinuxTracing",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/strings:strings",
    ],
)
