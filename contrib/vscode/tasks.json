{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "bazel: build everything",
      "command": "bazel",
      "args": ["build", "//..."],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "bazel: build Orbit (release)",
      "command": "bazel",
      "args": ["build", "-c", "opt", "//src/OrbitQt:Orbit"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "type": "shell",
      "label": "bazel: test everything",
      "command": "bazel",
      "args": ["test", "//..."],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
