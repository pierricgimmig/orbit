load("//bazel:copts.bzl", "ORBIT_COPTS")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "Introspection",
    srcs = ["Introspection.cpp"],
    hdrs = ["include/Introspection/Introspection.h"],
    copts = ORBIT_COPTS,
    includes = ["include"],
    deps = [
        "//src/ApiInterface",
        "//src/ApiUtils",
        "//src/OrbitBase",
    ],
)

cc_test(
    name = "IntrospectionTests",
    srcs = ["IntrospectionSmokeTest.cpp"],
    copts = ORBIT_COPTS,
    deps = [
        "//src/Introspection",
        "//src/OrbitBase",
        "//src/Test:gtest_main",
        "@abseil-cpp//absl/base:base",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/synchronization:synchronization",
    ],
)
