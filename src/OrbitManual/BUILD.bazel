load("//bazel:copts.bzl", "ORBIT_COPTS")
load("//bazel/qt:rules.bzl", "qt_application", "qt_cc_library", "qt_rcc")

package(default_visibility = ["//visibility:public"])

qt_cc_library(
    name = "OrbitManual",
    srcs = [
        "Chapters.cpp",
        "Manual.cpp",
        "Screenshots.cpp",
    ],
    hdrs = [
        "include/OrbitManual/Chapters.h",
        "include/OrbitManual/Manual.h",
        "include/OrbitManual/Screenshots.h",
    ],
    copts = ORBIT_COPTS,
    include_dirs = [
        ".",
        "include",
    ],
    deps = [
        "//src/OrbitBase",
        "//src/OrbitQt",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/time",
        "@qt5//:Core",
        "@qt5//:Gui",
        "@qt5//:Widgets",
    ],
)

# The manual is generated by the real UI against the real service, so both of those and the
# application being profiled are part of the tool.
qt_application(
    name = "GenerateManual",
    srcs = [
        "main.cpp",
        ":manualicons",
    ],
    copts = ORBIT_COPTS,
    data = [
        "//src/OrbitTest:OrbitTest",
        "//src/Service:OrbitService",
    ],
    deps = [
        "//src/ClientFlags",
        "//src/ClientServices",
        "//src/GrpcProtos",
        "//src/OrbitBase",
        "//src/OrbitManual",
        "//src/OrbitQt",
        "//src/OrbitVersion",
        "//src/SessionSetup",
        "//src/Style",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/flags:usage",
    ],
)

# The main window loads its toolbar icons from the same Qt resource the Orbit binary compiles in;
# without it every screenshot would be missing its icons.
qt_rcc(
    name = "manualicons",
    data = ["//icons:images"],
    qrc = "//icons:orbiticons.qrc",
    resource_name = "orbiticons",
)
