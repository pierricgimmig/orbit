load("//bazel:copts.bzl", "ORBIT_COPTS")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# UserSpaceInstrumentation needs x86-64 machine-code generation and register
# handling. On aarch64 we build the same headers against a stub implementation
# that returns "not supported", exactly as the CMake build did, so that
# OrbitService still links.
_X86_SRCS = [
    "AccessTraceesMemory.cpp",
    "AllocateInTracee.cpp",
    "AnyThreadIsInStrictSeccompMode.cpp",
    "Attach.cpp",
    "ExecuteInProcess.cpp",
    "ExecuteMachineCode.cpp",
    "FindFunctionAddress.cpp",
    "InjectLibraryInTracee.cpp",
    "InstrumentProcess.cpp",
    "MachineCode.cpp",
    "ReadSeccompModeOfThread.cpp",
    "RegisterState.cpp",
    "Trampoline.cpp",
]

_X86_HDRS = [
    "AccessTraceesMemory.h",
    "AllocateInTracee.h",
    "ExecuteMachineCode.h",
    "FindFunctionAddress.h",
    "MachineCode.h",
    "ReadSeccompModeOfThread.h",
    "RegisterState.h",
    "Trampoline.h",
]

_PUBLIC_HDRS = [
    "include/UserSpaceInstrumentation/AddressRange.h",
    "include/UserSpaceInstrumentation/AnyThreadIsInStrictSeccompMode.h",
    "include/UserSpaceInstrumentation/Attach.h",
    "include/UserSpaceInstrumentation/ExecuteInProcess.h",
    "include/UserSpaceInstrumentation/InjectLibraryInTracee.h",
    "include/UserSpaceInstrumentation/InstrumentProcess.h",
]

cc_library(
    name = "UserSpaceInstrumentation",
    srcs = select({
        "@platforms//cpu:aarch64": ["StubArm64.cpp"],
        "//conditions:default": _X86_SRCS,
    }),
    hdrs = _PUBLIC_HDRS + select({
        "@platforms//cpu:aarch64": [],
        "//conditions:default": _X86_HDRS,
    }),
    copts = ORBIT_COPTS + [
        "-Isrc/UserSpaceInstrumentation",
    ],
    includes = ["include"],
    deps = [
        "//src/GrpcProtos",
        "//src/OrbitBase",
    ] + select({
        "@platforms//cpu:aarch64": [],
        "//conditions:default": [
            "//src/ModuleUtils",
            "//src/ObjectUtils",
            "@abseil-cpp//absl/base:base",
            "@abseil-cpp//absl/container:flat_hash_set",
            "@abseil-cpp//absl/strings:str_format",
            "@abseil-cpp//absl/strings:strings",
            "@abseil-cpp//absl/synchronization:synchronization",
            "@abseil-cpp//absl/time:time",
            "@abseil-cpp//absl/types:span",
            "@capstone//:capstone",
        ],
    }),
)

cc_binary(
    name = "liborbituserspaceinstrumentation.so",
    srcs = [
        "OrbitUserSpaceInstrumentation.cpp",
        "OrbitUserSpaceInstrumentation.h",
    ],
    copts = ORBIT_COPTS + [
        "-Isrc/UserSpaceInstrumentation",
    ],
    linkshared = True,
    linkstatic = True,
    deps = [
        "//src/CaptureEventProducer",
        "//src/OrbitBase",
        "//src/ProducerSideChannel",
    ],
)

cc_binary(
    name = "libUserSpaceInstrumentationTestLib.so",
    srcs = [
        "UserSpaceInstrumentationTestLib.cpp",
        "UserSpaceInstrumentationTestLib.h",
    ],
    copts = ORBIT_COPTS + [
        "-Isrc/UserSpaceInstrumentation",
    ],
    linkshared = True,
    linkstatic = True,
)

cc_test(
    name = "UserSpaceInstrumentationTests",
    srcs = [
        "AccessTraceesMemoryTest.cpp",
        "AllocateInTraceeTest.cpp",
        "AttachTest.cpp",
        "ExecuteInProcessTest.cpp",
        "ExecuteMachineCodeTest.cpp",
        "FindFunctionAddressTest.cpp",
        "GetTestLibLibraryPath.cpp",
        "GetTestLibLibraryPath.h",
        "InjectLibraryInTraceeTest.cpp",
        "InstrumentProcessTest.cpp",
        "MachineCodeTest.cpp",
        "ReadSeccompModeOfThreadTest.cpp",
        "RegisterStateTest.cpp",
        "TestProcess.cpp",
        "TestProcess.h",
        "TestUtils.cpp",
        "TestUtils.h",
        "TestUtilsTest.cpp",
        "TrampolineTest.cpp",
    ],
    copts = ORBIT_COPTS,
    data = [
        ":libUserSpaceInstrumentationTestLib.so",
        ":liborbituserspaceinstrumentation.so",
    ],
    includes = ["."],
    # InstrumentProcessTest.Instrument has a race between the injected
    # thread exiting and gRPC's event-engine thread pool being created.
    # Diagnosed, not yet fixed; CI runs this suite non-gating.
    tags = ["known_flaky"],
    deps = [
        "//src/Test:gtest_main",
        "//src/TestUtils",
        "//src/UserSpaceInstrumentation",
        "@capstone//:capstone",
        "@googletest//:gtest",
    ],
)
