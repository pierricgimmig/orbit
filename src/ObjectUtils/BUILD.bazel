load("//bazel:copts.bzl", "ORBIT_COPTS")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Shared with //rust:orbit_object_test so both implementations are tested
# against exactly the same bytes.
filegroup(
    name = "testdata",
    srcs = glob(["testdata/**"]),
)

# Headers only, so //rust/shims/ObjectUtilsRust can implement ElfFile without
# depending on the LLVM implementation of it. This is what keeps
# ObjectUtils -> ObjectUtilsRust from being a cycle.
cc_library(
    name = "ObjectUtilsHeaders",
    hdrs = [
        "include/ObjectUtils/CoffFile.h",
        "include/ObjectUtils/ElfFile.h",
        "include/ObjectUtils/ObjectFile.h",
        "include/ObjectUtils/PdbFile.h",
        "include/ObjectUtils/SymbolsFile.h",
        "include/ObjectUtils/WindowsBuildIdUtils.h",
    ],
    srcs = [
        "SymbolsFileHelpers.cpp",
        "WindowsBuildIdUtils.cpp",
    ],
    copts = ORBIT_COPTS,
    includes = ["include"],
    deps = [
        "//src/GrpcProtos",
        "//src/OrbitBase",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/strings:strings",
    ],
)

cc_library(
    name = "ObjectUtils",
    srcs = [
        "ObjectFile.cpp",
        "ObjectFileBackend.cpp",
        "PdbFile.cpp",
        "SymbolsFile.cpp",
    ] + select({
        "@platforms//os:windows": [
            "PdbFileDia.cpp",
            "PdbUtilsDia.cpp",
        ],
        "//conditions:default": [],
    }),
    hdrs = [
        "ObjectFileBackend.h",
        "include/ObjectUtils/CoffFile.h",
        "include/ObjectUtils/ElfFile.h",
        "include/ObjectUtils/ObjectFile.h",
        "include/ObjectUtils/PdbFile.h",
        "include/ObjectUtils/SymbolsFile.h",
        "include/ObjectUtils/WindowsBuildIdUtils.h",
    ] + select({
        "@platforms//os:windows": [
            "PdbFileDia.h",
            "include/ObjectUtils/PdbUtilsDia.h",
        ],
        "//conditions:default": [],
    }),
    copts = ORBIT_COPTS,
    includes = ["include"],
    deps = [
        ":ObjectUtilsHeaders",
        # The shims are cross-platform now, so this is not in the select below:
        # Windows reads ELF too, for profiling Linux targets from a Windows UI.
        "//rust/shims/Demangle",
        "//rust/shims/ObjectUtilsRust",
        "//src/GrpcProtos",
        "//src/Introspection",
        "//src/OrbitBase",
        "@abseil-cpp//absl/base:base",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/memory:memory",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/strings:strings",
        "@abseil-cpp//absl/synchronization:synchronization",
        "@abseil-cpp//absl/time:time",
        "@abseil-cpp//absl/types:span",
    ] + select({
        "@platforms//os:windows": [
            "@dia_sdk//:dia_sdk",
        ],
        "//conditions:default": [],
    }),
)

cc_test(
    name = "ObjectUtilsTests",
    srcs = [
        "CoffFileTest.cpp",
        "ElfFileTest.cpp",
        "ObjectFileTest.cpp",
        "PdbFileTest.h",
        "SymbolsFileTest.cpp",
        "WindowsBuildIdUtilsTest.cpp",
    ] + select({
        "@platforms//os:windows": [
            "PdbFileDiaTest.cpp",
        ],
        "//conditions:default": [],
    }),
    copts = ORBIT_COPTS,
    data = glob(["testdata/**"]),
    env = {"ORBIT_OVERRIDE_TESTDATA_PATH": "src/ObjectUtils/testdata"},
    deps = [
        "//src/ObjectUtils",
        "//src/Test:gtest_main",
        "//src/TestUtils",
    ],
)
