load("//bazel:copts.bzl", "ORBIT_COPTS")
load("//bazel:dual_backend.bzl", "orbit_dual_backend_test")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Shared with //rust:orbit_object_test so both implementations are tested
# against exactly the same bytes.
filegroup(
    name = "testdata",
    srcs = glob(["testdata/**"]),
)

# Headers only, so //rust/shims/ObjectUtilsRust can implement ElfFile without
# depending on the LLVM implementation of it. This is what keeps
# ObjectUtils -> ObjectUtilsRust from being a cycle.
cc_library(
    name = "ObjectUtilsHeaders",
    hdrs = [
        "include/ObjectUtils/CoffFile.h",
        "include/ObjectUtils/ElfFile.h",
        "include/ObjectUtils/ObjectFile.h",
        "include/ObjectUtils/PdbFile.h",
        "include/ObjectUtils/SymbolsFile.h",
        "include/ObjectUtils/WindowsBuildIdUtils.h",
    ],
    srcs = ["WindowsBuildIdUtils.cpp"],
    copts = ORBIT_COPTS,
    includes = ["include"],
    deps = [
        "//src/GrpcProtos",
        "//src/OrbitBase",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/strings:strings",
    ],
)

cc_library(
    name = "ObjectUtils",
    srcs = [
        "CoffFile.cpp",
        "ElfFile.cpp",
        "ElfFileBackend.cpp",
        "ObjectFile.cpp",
        "PdbFile.cpp",
        "PdbFileLlvm.cpp",
        "SymbolsFile.cpp",
    ] + select({
        "@platforms//os:windows": [
            "PdbFileDia.cpp",
            "PdbUtilsDia.cpp",
        ],
        "//conditions:default": [],
    }),
    hdrs = [
        "ElfFileBackend.h",
        "ObjectFileLlvm.h",
        "PdbFileLlvm.h",
        "include/ObjectUtils/CoffFile.h",
        "include/ObjectUtils/ElfFile.h",
        "include/ObjectUtils/ObjectFile.h",
        "include/ObjectUtils/PdbFile.h",
        "include/ObjectUtils/SymbolsFile.h",
        "include/ObjectUtils/WindowsBuildIdUtils.h",
    ] + select({
        "@platforms//os:windows": [
            "PdbFileDia.h",
            "include/ObjectUtils/PdbUtilsDia.h",
        ],
        "//conditions:default": [],
    }),
    copts = ORBIT_COPTS,
    includes = ["include"],
    deps = [
        ":ObjectUtilsHeaders",
        "//bazel/deps:llvm",
        "//src/GrpcProtos",
        "//src/Introspection",
        "//src/OrbitBase",
        "@abseil-cpp//absl/base:base",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/memory:memory",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/strings:strings",
        "@abseil-cpp//absl/synchronization:synchronization",
        "@abseil-cpp//absl/time:time",
        "@abseil-cpp//absl/types:span",
    ] + select({
        "@platforms//os:windows": [
            "@dia_sdk//:dia_sdk",
        ],
        "//conditions:default": ["//rust/shims/ObjectUtilsRust"],
    }),
)

# The whole suite runs against both backends. ElfFileTest is the bulk of it,
# but ObjectFileTest and SymbolsFileTest construct ELF files too.
orbit_dual_backend_test(
    name = "ObjectUtilsTests",
    backend_env_var = "ORBIT_OBJECT_BACKEND",
    srcs = [
        "CoffFileTest.cpp",
        "ElfFileTest.cpp",
        "ObjectFileTest.cpp",
        "PdbFileLlvmTest.cpp",
        "PdbFileTest.h",
        "SymbolsFileTest.cpp",
        "WindowsBuildIdUtilsTest.cpp",
    ] + select({
        "@platforms//os:windows": [
            "PdbFileDiaTest.cpp",
        ],
        "//conditions:default": [],
    }),
    copts = ORBIT_COPTS,
    data = glob(["testdata/**"]),
    env = {"ORBIT_OVERRIDE_TESTDATA_PATH": "src/ObjectUtils/testdata"},
    deps = [
        "//src/ObjectUtils",
        "//src/Test:gtest_main",
        "//src/TestUtils",
    ],
)
