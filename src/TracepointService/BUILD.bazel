load("//bazel:copts.bzl", "ORBIT_COPTS")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "TracepointService",
    srcs = [
        "ReadTracepoints.cpp",
        "TracepointServiceImpl.cpp",
    ],
    hdrs = [
        "ReadTracepoints.h",
        "include/TracepointService/TracepointServiceImpl.h",
    ],
    copts = ORBIT_COPTS + [
        "-Isrc/TracepointService",
    ],
    includes = ["include"],
    deps = [
        "//src/GrpcProtos",
        "//src/OrbitBase",
    ],
)

cc_test(
    name = "TracepointServiceTests",
    srcs = ["ReadTracepointsTest.cpp"],
    copts = ORBIT_COPTS,
    deps = [
        "//src/Test:gtest_main",
        "//src/TestUtils",
        "//src/TracepointService",
    ],
)
