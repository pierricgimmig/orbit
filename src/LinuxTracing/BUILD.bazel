cc_test(
    name = "LinuxTracingTests",
    srcs = [
        "GpuTracepointVisitorTest.cpp",
        "LeafFunctionCallManagerTest.cpp",
        "LibunwindstackMapsTest.cpp",
        "LibunwindstackMultipleOfflineAndProcessMemoryTest.cpp",
        "LibunwindstackUnwinderTest.cpp",
        "LinuxTracingUtilsTest.cpp",
        "LostAndDiscardedEventVisitorTest.cpp",
        "MockTracerListener.h",
        "PerfEventProcessorTest.cpp",
        "PerfEventRecordsLayoutParityTest.cpp",
        "SwitchesStatesNamesVisitorTest.cpp",
        "UprobeEventsTest.cpp",
        "UprobesReturnAddressManagerTest.cpp",
        "UprobesUnwindingVisitorCallchainTest.cpp",
        "UprobesUnwindingVisitorDwarfUnwindingTest.cpp",
        "UprobesUnwindingVisitorDynamicInstrumentationTest.cpp",
        "UprobesUnwindingVisitorMmapTest.cpp",
        "UprobesUnwindingVisitorTestCommon.h",
    ],
    copts = ORBIT_COPTS,
    data = glob(["testdata/**"]),
    env = {"ORBIT_OVERRIDE_TESTDATA_PATH": "src/LinuxTracing/testdata"},
    deps = [
        "//rust:orbit_perf_records_ffi",
        "//src/LinuxTracing",
        "//src/Test:gtest_main",
        "@googletest//:gtest",
    ],
)

# PerfEventQueue has a C++ and a Rust implementation; the same assertions run
# against both, and "both" mode runs them side by side and aborts on any
# disagreement. Split from LinuxTracingTests so the backend can be varied
# without tripling that whole suite.
orbit_dual_backend_test(
    name = "PerfEventQueueTests",
    size = "small",
    srcs = ["PerfEventQueueTest.cpp"],
    backend_env_var = "ORBIT_PERF_MERGE_BACKEND",
    copts = ORBIT_COPTS + [
        "-Isrc/LinuxTracing",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":LinuxTracing",
        "//src/Test:gtest_main",
        "@googletest//:gtest",
    ],
)

orbit_dual_backend_test(
    name = "ThreadStateManagerTests",
