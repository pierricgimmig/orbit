load("//bazel:copts.bzl", "ORBIT_COPTS")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "DisplayFormats",
    srcs = ["DisplayFormats.cpp"],
    hdrs = ["include/DisplayFormats/DisplayFormats.h"],
    copts = ORBIT_COPTS,
    includes = ["include"],
    deps = [
        "//src/OrbitBase",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/time:time",
    ],
)

cc_test(
    name = "DisplayFormatsTests",
    srcs = ["DisplayFormatsTest.cpp"],
    copts = ORBIT_COPTS,
    deps = [
        "//src/DisplayFormats",
        "//src/OrbitBase",
        "//src/Test:gtest_main",
    ],
)
