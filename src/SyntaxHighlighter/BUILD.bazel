load("//bazel/qt:rules.bzl", "qt_cc_library")
load("//bazel:copts.bzl", "ORBIT_COPTS")

package(default_visibility = ["//visibility:public"])

qt_cc_library(
    name = "SyntaxHighlighter",
    srcs = [
        "Cpp.cpp",
        "X86Assembly.cpp",
    ],
    hdrs = ["include/SyntaxHighlighter/HighlightingMetadata.h"],
    moc_hdrs = [
        "include/SyntaxHighlighter/Cpp.h",
        "include/SyntaxHighlighter/X86Assembly.h",
    ],
    copts = ORBIT_COPTS,
    include_dirs = ["include"],
    deps = [
        "//src/OrbitBase",
        "@qt5//:Gui",
    ],
)
