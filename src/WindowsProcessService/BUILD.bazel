load("//bazel:copts.bzl", "ORBIT_COPTS")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "WindowsProcessService",
    srcs = ["ProcessServiceImpl.cpp"],
    hdrs = ["include/WindowsProcessService/ProcessServiceImpl.h"],
    copts = ORBIT_COPTS + [
        "-Isrc/WindowsProcessService",
    ],
    target_compatible_with = ["@platforms//os:windows"],
    includes = ["include"],
    deps = [
        "//src/GrpcProtos",
        "//src/ObjectUtils",
        "//src/OrbitBase",
        "//src/WindowsTracing",
        "//src/WindowsUtils",
    ],
)
