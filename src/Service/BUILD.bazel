load("//bazel:copts.bzl", "ORBIT_COPTS")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

copy_file(
    name = "copy_liborbit_so",
    src = "//src/Api:liborbit.so",
    out = "liborbit.so",
    is_executable = True,
)

copy_file(
    name = "copy_liborbituserspaceinstrumentation_so",
    src = "//src/UserSpaceInstrumentation:liborbituserspaceinstrumentation.so",
    out = "liborbituserspaceinstrumentation.so",
    is_executable = True,
)

cc_library(
    name = "OrbitServiceLib",
    srcs = [
        "OrbitGrpcServer.cpp",
        "OrbitService.cpp",
    ] + select({
        "@platforms//os:windows": [],
        "//conditions:default": [
            "LiveCaptureStart.cpp",
            "LiveCaptureSymbols.cpp",
            "LiveViewerBridge.cpp",
        ],
    }),
    hdrs = [
        "OrbitGrpcServer.h",
        "OrbitService.h",
    ] + select({
        "@platforms//os:windows": [],
        "//conditions:default": [
            "LiveCaptureStart.h",
            "LiveCaptureSymbols.h",
            "LiveViewerBridge.h",
        ],
    }),
    copts = ORBIT_COPTS + select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-Isrc/ProcessService"],
    }),
    includes = ["."],
    deps = [
        "//src/CrashService",
        "//src/GrpcProtos",
        "//src/LinuxCaptureService",
        "//src/OrbitVersion",
        "//src/ProcessService",
        "//src/ProducerSideService",
        "//src/TracepointService",
    ] + select({
        "@platforms//os:windows": [
            "//src/WindowsCaptureService",
            "//src/WindowsProcessService",
        ],
        # :orbit_live_ffi carries defines = ["ORBIT_LIVE_VIEWER=1"], which is
        # what un-#ifdefs the bridge in OrbitService.cpp.
        "//conditions:default": [
            "//src/ApiUtils",
            "//src/ModuleUtils",
            "//src/ObjectUtils",
            "//src/OrbitLiveViewer:orbit_live_ffi",
            "//src/Symbols",
        ],
    }),
)

cc_test(
    name = "OrbitServiceTests",
    srcs = [
        "LiveCaptureStartTest.cpp",
        "LiveCaptureSymbolsTest.cpp",
    ],
    copts = ORBIT_COPTS,
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":OrbitServiceLib",
        "//src/Test:gtest_main",
    ],
)

cc_binary(
    name = "OrbitService",
    srcs = ["main.cpp"],
    copts = ORBIT_COPTS,
    data = [
        ":liborbit.so",
        ":liborbituserspaceinstrumentation.so",
    ],
    deps = [
        "//src/Service:OrbitServiceLib",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/flags:usage",
    ],
)
