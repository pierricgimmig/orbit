	"IsBetaVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "PerfrProfiler",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit",
			"PlatformAllowList": [ "Linux", "Win64", "Mac" ]
		}
	]
