 // Advanced macro for integrating e.g. stats/named events with CPU trace.
+#if UE_PERFR_CPU_TRACE
+// The perfr side of TRACE_CPUPROFILER_EVENT_SCOPE_USE: a scope for the
+// duration of the Insights event, whatever form its name takes.
+struct FPerfrCpuTraceScope
+{
+	perfr_scope Handle = 0;
+
+	FORCEINLINE explicit FPerfrCpuTraceScope(const ANSICHAR* Name, bool bCondition)
+	{
+		if (bCondition && perfr_available())
+		{
+			Handle = perfr_start(Name, strlen(Name));
+		}
+	}
+
+	FORCEINLINE explicit FPerfrCpuTraceScope(const TCHAR* Name, bool bCondition)
+	{
+		if (bCondition && perfr_available())
+		{
+			ANSICHAR Narrow[256];
+			int32 Len = 0;
+			for (; Len < 255 && Name[Len]; ++Len)
+			{
+				Narrow[Len] = (Name[Len] < 128) ? static_cast<ANSICHAR>(Name[Len]) : '?';
+			}
+			Handle = perfr_start(Narrow, Len);
+		}
+	}
+
+	FORCEINLINE explicit FPerfrCpuTraceScope(const FName& Name, bool bCondition)
+	{
+		if (bCondition && perfr_available())
+		{
+			ANSICHAR Plain[NAME_SIZE];
+			Name.GetPlainANSIString(Plain);
+			Handle = perfr_start(Plain, strlen(Plain));
+		}
+	}
+
+	FORCEINLINE ~FPerfrCpuTraceScope()
+	{
+		if (Handle)
+		{
+			perfr_stop(Handle);
+		}
+	}
+};
+#define UE_PERFR_CPU_TRACE_SCOPE(ScopeName, NameStr, Condition) \
+	FPerfrCpuTraceScope UE_JOIN(ScopeName, _Perfr)(NameStr, (Condition));
+#else
+#define UE_PERFR_CPU_TRACE_SCOPE(ScopeName, NameStr, Condition)
+#endif
+
