	"IsBetaVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "OrbitProfiler",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit",
			"PlatformAllowList": [ "Linux", "Win64", "Mac" ]
		}
	]
}
