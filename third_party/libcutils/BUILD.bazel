load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # Apache-2.0, see NOTICE.

# Only the headers are needed; liblog includes <cutils/...> but none of
# libcutils' implementation is compiled.
cc_library(
    name = "headers",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
)

exports_files(["NOTICE"])
