load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # MIT

cc_library(
    name = "cppwin32",
    hdrs = glob(
        [
            "cppwin32/**/*.h",
            "cppwin32/**/*.hpp",
        ],
        allow_empty = True,
    ),
    includes = [
        ".",
        "cppwin32/winmd",
    ],
    target_compatible_with = ["@platforms//os:windows"],
)

exports_files(["LICENSE"])
