load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # MIT

# Header-only C++ wrapper around ETW, used by WindowsTracing.
cc_library(
    name = "krabsetw",
    hdrs = glob(["krabs/**/*.hpp"]) + glob(
        ["krabs/**/*.h"],
        allow_empty = True,
    ),
    includes = ["."],
    target_compatible_with = ["@platforms//os:windows"],
)

exports_files(["LICENSE"])
