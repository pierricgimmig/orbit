+// The piece-square (HalfKA) weight columns are 2 KiB of i16 in a table far
+// larger than L3, and unlike the threat columns they were never prefetched:
+// precise profiling showed every line of each column missing L3 on first
+// touch in the tile passes. Each pass reads one TileHeight chunk of every
+// column, so while working on tile j we prefetch the chunk tile j+1 will
+// read. The psq lists hold at most two entries each.
+#if defined(VECTOR) && !defined(USE_RVV)
+template<typename IdxType, usize MaxLen>
+sf_always_inline void prefetch_psq_chunk(const FeatureTransformer&         ft,
+                                         const ValueList<IdxType, MaxLen>& list,
+                                         IndexType                         j) {
+    if (j >= Dimensions)
+        return;
+    for (int i = 0; i < list.ssize(); ++i)
+    {
+        const char* p = reinterpret_cast<const char*>(&ft.weights[list[i] * Dimensions + j]);
+        for (usize off = 0; off < Tiling::TileHeight * sizeof(i16); off += 64)
+            prefetch<PrefetchRw::READ, PrefetchLoc::HIGH>(p + off);
+    }
+}
+#else
+template<typename IdxType, usize MaxLen>
+sf_always_inline void prefetch_psq_chunk(const FeatureTransformer&, const ValueList<IdxType, MaxLen>&, IndexType) {}
+#endif
+
