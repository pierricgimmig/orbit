+// Pull every cache line of a feature-transformer weight column into cache
+// before the tile passes read it. The piece-square (HalfKA) columns are 2 KiB
+// of i16 and, unlike the threat columns, were never prefetched: the profile
+// showed the tile passes stalling on their first loads. The psq lists hold at
+// most two entries each, so this is a few dozen prefetches per update.
+template<typename T>
+sf_always_inline void prefetch_column(const T* base, IndexType index, IndexType count) {
+    const char* p = reinterpret_cast<const char*>(base + usize(index) * count);
+    for (usize off = 0; off < sizeof(T) * count; off += 64)
+        prefetch<PrefetchRw::READ, PrefetchLoc::LOW>(p + off);
+}
+
+template<typename IdxType, usize MaxLen>
+sf_always_inline void prefetch_psq_columns(const FeatureTransformer&         ft,
+                                           const ValueList<IdxType, MaxLen>& list) {
+    for (int i = 0; i < list.ssize(); ++i)
+    {
+        prefetch_column(&ft.weights[0], list[i], Dimensions);
+        prefetch_column(&ft.psqtWeights[0], list[i], PSQTBuckets);
+    }
+}
